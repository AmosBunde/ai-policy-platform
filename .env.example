# RegulatorAI environment configuration
# Copy to .env and fill in real values: cp .env.example .env
# Never commit .env — it is gitignored.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Service ports (host mappings) ---
GATEWAY_PORT=8000

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=regulatorai
POSTGRES_USER=regulatorai
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Generate: openssl rand -hex 16
REDIS_PASSWORD=

# --- Elasticsearch ---
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
# Generate: openssl rand -hex 16
ELASTICSEARCH_PASSWORD=

# --- JWT ---
# MUST be at least 32 characters; services refuse to start otherwise.
# Generate: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Service-to-service auth ---
# Shared token the gateway sends to internal services (X-Internal-Token).
# MUST be at least 32 characters when set. In development it may be left
# empty (internal services log a warning and allow); any other APP_ENV
# fails closed without it.
# Generate: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Notifications (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=

# --- Observability ---
# Generate: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=
